MOCK_MODE=true
MOCK_STEP_DELAY=0.45
AGENT_BACKEND=local
# AGENT_BACKEND=adk runs a Google ADK LlmAgent/Runner narration step before the local tool pipeline.
# AGENT_BACKEND=runtime calls the deployed Agent Runtime workflow.
ARTIFACT_DIR=artifacts
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Required on Cloud Run. Leave empty only for local mock-mode development.
APP_PASSWORD=
# Required on Cloud Run. Set a long random value to keep login cookies valid across revisions.
APP_SECRET_KEY=
APP_ENV=
AUTH_COOKIE_MAX_AGE_SECONDS=28800
APP_LOG_FORMAT=json
LOG_LEVEL=INFO
ARTICLE_FETCH_MAX_BYTES=2000000
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_SECONDS=0.6

# Local fallback for Gemini Developer API. Prefer Vertex AI for the PoC/production deployment.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Preferred for Cloud Run / Gemini Enterprise Agent Platform with ADC.
GOOGLE_GENAI_USE_VERTEXAI=false

# Cloud Run / Agent Runtime settings.
AGENT_RUNTIME_RESOURCE_NAME=
AGENT_RUNTIME_LOCATION=us-central1
AGENT_RUNTIME_USER_ID=poc-user
AGENT_DISPLAY_NAME=infographics-agent
AGENT_RUNTIME_STAGING_BUCKET=
AGENT_RUNTIME_REQUIREMENTS_FILE=constraints.txt
GOOGLE_CLOUD_PROJECT=
PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
GCS_BUCKET=
GCS_ARTIFACT_PREFIX=artifacts
GCS_SIGNED_URL_TTL_SECONDS=28800
GCS_SIGNING_SERVICE_ACCOUNT=

# Injected by Cloud Run environment in production.
K_SERVICE=
